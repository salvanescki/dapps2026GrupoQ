      "name": "5. OMS - Mercado Secundario",
      "item": [
        {
          "name": "POST Publicar Orden de Venta",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Orden PENDIENTE creada', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.estado).to.eql('PENDIENTE');",
                  "  pm.expect(json).to.have.property('cantidadRestante');",
                  "  pm.expect(json).to.have.property('precioUnitario');",
                  "  pm.collectionVariables.set('orden_venta_id', json.ordenId);",
                  "    pm.environment.set('orden_venta_id', json.ordenId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
