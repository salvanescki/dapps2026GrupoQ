    {
      "name": "2. Catálogo de Jugadores",
      "item": [
        {
          "name": "GET Catálogo Paginado",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Tiene items', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('items');",
                  "  pm.expect(json.items).to.be.an('array');",
                  "  if (json.items.length > 0) {",
                  "    pm.collectionVariables.set('jugador_id', json.items[0].id);",
                  "    pm.environment.set('jugador_id', json.items[0].id);",
                  "  }",
                  "});"
