{
  "info": {
    "_postman_id": "8f8b631d-b847-49d7-8cfb-6f81b1511234",
    "name": "Football Player Token Marketplace - Auth API (Grupo Q)",
    "description": "Colección de endpoints para registro, autenticación JWT y perfil de usuario según especificación 001-user-auth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Registro de Usuario (US1)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "if (jsonData.tokenDeAcceso) {",
              "    pm.environment.set(\"jwt_token\", jsonData.tokenDeAcceso);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Lionel Scaloni\",\n  \"correo\": \"scaloni@afa.com\",\n  \"contrasena\": \"Campeon2022\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/register",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "register"]
        },
        "description": "Registra una nueva cuenta de usuario y obtiene el primer token JWT."
      }
    },
    {
      "name": "2. Inicio de Sesión (Login) (US2)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "if (jsonData.tokenDeAcceso) {",
              "    pm.environment.set(\"jwt_token\", jsonData.tokenDeAcceso);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"scaloni@afa.com\",\n  \"contrasena\": \"Campeon2022\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login"]
        },
        "description": "Autentica credenciales y actualiza la variable de entorno jwt_token."
      }
    },
    {
      "name": "3. Obtener Perfil Autenticado (US3)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Contiene datos de usuario\", function () {",
              "    pm.expect(jsonData).to.have.property(\"correo\");",
              "    pm.expect(jsonData.correo).to.eql(\"scaloni@afa.com\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwt_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/auth/me",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "me"]
        },
        "description": "Consulta el perfil del usuario utilizando el token JWT en la cabecera Authorization."
      }
    },
    {
      "name": "4. Cerrar Sesión (Logout) (US3)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwt_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/auth/logout",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "logout"]
        },
        "description": "Cierra la sesión activa."
      }
    },
    {
      "name": "5. Error: Login con Contraseña Errónea",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 401 Unauthorized\", function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"scaloni@afa.com\",\n  \"contrasena\": \"ClaveIncorrecta1\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "Catálogo de Jugadores",
      "item": [
        {
          "name": "1. Obtener Catálogo Paginado de Jugadores",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Response has items array and pagination\", function () {",
                  "    pm.expect(jsonData).to.have.property('items');",
                  "    pm.expect(jsonData).to.have.property('total');",
                  "    pm.expect(jsonData).to.have.property('page');",
                  "    pm.expect(jsonData).to.have.property('limit');",
                  "});",
                  "if (jsonData.items && jsonData.items.length > 0) {",
                  "    pm.environment.set(\"player_id\", jsonData.items[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/players?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["players"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Retorna el catálogo paginado de jugadores de las 5 grandes ligas."
          }
        },
        {
          "name": "2. Filtrar por Liga y Posición",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/players?league=PL&position=Delantero&page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["players"],
              "query": [
                { "key": "league", "value": "PL" },
                { "key": "position", "value": "Delantero" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Filtra jugadores pertenecientes a la Premier League en posición Delantero."
          }
        },
        {
          "name": "3. Obtener Opciones de Filtros",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Contains ligas, equipos and posiciones\", function () {",
                  "    pm.expect(jsonData).to.have.property('ligas');",
                  "    pm.expect(jsonData).to.have.property('equipos');",
                  "    pm.expect(jsonData).to.have.property('posiciones');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/players/filters",
              "host": ["{{base_url}}"],
              "path": ["players", "filters"]
            },
            "description": "Obtiene las listas de ligas, equipos y posiciones para poblar los filtros dinámicos."
          }
        },
        {
          "name": "4. Obtener Detalle de Jugador por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK or 404\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/players/{{player_id}}",
              "host": ["{{base_url}}"],
              "path": ["players", "{{player_id}}"]
            },
            "description": "Obtiene la ficha técnica completa de un jugador por su identificador UUID."
          }
        },
        {
          "name": "5. Sincronización Manual de Jugadores",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/players/sync",
              "host": ["{{base_url}}"],
              "path": ["players", "sync"]
            },
            "description": "Dispara la sincronización manual idempotente de las 5 grandes ligas desde football-data.org."
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "jwt_token",
      "value": ""
    }
  ]
}
