{
  "name": "football-tokens-backend",
  "version": "0.0.1",
  "description": "Backend API para Football Player Token Marketplace (Grupo Q)",
  "author": "Grupo Q",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:unit": "jest --config ./test/jest-unit.json",
    "test:unit:cov": "jest --config ./test/jest-unit.json --coverage",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "test:integration:cov": "jest --config ./test/jest-integration.json --runInBand --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:e2e:cov": "jest --config ./test/jest-e2e.json --runInBand --coverage",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "playwright:install": "playwright install chromium --with-deps",
    "scraper:run": "npm run build && node dist/run-scraper.js",
    "sync:run": "npm run build && node dist/run-sync-players.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.5",
    "@nestjs/core": "^11.2.5",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.3",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "ioredis": "^5.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "playwright": "^1.64.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.5",
    "@testcontainers/postgresql": "^10.7.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.24",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "jest": "^30.5.2",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.4",
    "testcontainers": "^10.7.1",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "tar": "^7.5.22",
    "multer": "^2.4.0",
    "picomatch": "^4.0.7",
    "qs": "^6.16.0",
    "tmp": "^0.2.7",
    "undici": "^6.28.0",
    "uuid": "^11.1.1",
    "lodash": "^4.18.1",
    "webpack": "^5.111.1",
    "body-parser": "^1.20.8",
    "js-yaml": "^4.3.2",
    "ajv": "^8.20.0",
    "file-type": "^21.3.4"
  }
}
