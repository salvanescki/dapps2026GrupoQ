PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL local (Docker Compose)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=football_tokens_db
DB_LOGGING=false

# Cache Redis local (Docker Compose)
REDIS_HOST=localhost
REDIS_PORT=6379
# Override explicito de Redis L1 ('true' | 'false').
# Si se omite: en 'production' queda deshabilitado sin warnings cuando faltan REDIS_URL y REDIS_HOST;
# en 'development' y 'test' permanece habilitado por defecto.
# REDIS_ENABLED=true

# Observabilidad y Auditoria Estructurada (nestjs-pino)
# Valores permitidos para LOG_LEVEL: fatal | error | warn | info | debug | trace | silent
# Por defecto: 'info' en production/development, 'silent' en test. Con 'debug' incluye rutas tecnicas (/health/*, /metrics, /api/docs*).
LOG_LEVEL=info
# Formato legible en consola solo para desarrollo local ('true' | 'false').
# Por defecto: 'true' en development, 'false' en production/test (en production siempre se fuerza JSON NDJSON crudo).
LOG_PRETTY=true

# Seguridad y Autenticación JWT
JWT_SECRET=super_secreto_para_desarrollo_tokens_2026_grupo_q
JWT_EXPIRATION=24h

# Superusuario ADMIN (Bootstrap Marketplace)
ADMIN_CORREO=admin@marketplace.com
ADMIN_CONTRASENA=Admin1234!
ADMIN_NOMBRE="Administrador Marketplace"

# API Key football-data.org
FOOTBALL_DATA_API_KEY=tu_api_key
FOOTBALL_DATA_HEADER=X-Auth-Token

# Scraping WhoScored
WHOSCORED_DELAY_MIN_MS=2000
WHOSCORED_DELAY_MAX_MS=5000
WHOSCORED_SEASON_LABEL="2025/2026"
WHOSCORED_LEAGUE_CONFIGS='[{"liga":"PL","regionId":252,"tournamentId":2,"seasonId":12345,"stageId":22345},{"liga":"PD","regionId":206,"tournamentId":4,"seasonId":12346,"stageId":22346},{"liga":"SA","regionId":108,"tournamentId":5,"seasonId":12347,"stageId":22347},{"liga":"BL1","regionId":81,"tournamentId":3,"seasonId":12348,"stageId":22348},{"liga":"FL1","regionId":74,"tournamentId":22,"seasonId":12349,"stageId":22349}]'
