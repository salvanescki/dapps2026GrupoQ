PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL local (Docker Compose)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=football_tokens_db

# Seguridad y Autenticación JWT
JWT_SECRET=super_secreto_para_desarrollo_tokens_2026_grupo_q
JWT_EXPIRATION=24h

# API Key football-data.org
FOOTBALL_DATA_API_KEY=tu_api_key
FOOTBALL_DATA_HEADER=X-Auth-Token

# Scraping WhoScored
WHOSCORED_DELAY_MIN_MS=2000
WHOSCORED_DELAY_MAX_MS=5000
WHOSCORED_SEASON_LABEL="2025/2026"
WHOSCORED_LEAGUE_CONFIGS='[{"liga":"PL","regionId":252,"tournamentId":2,"seasonId":12345,"stageId":22345},{"liga":"LL","regionId":206,"tournamentId":4,"seasonId":12346,"stageId":22346},{"liga":"SA","regionId":108,"tournamentId":5,"seasonId":12347,"stageId":22347},{"liga":"BL","regionId":81,"tournamentId":3,"seasonId":12348,"stageId":22348},{"liga":"L1","regionId":74,"tournamentId":22,"seasonId":12349,"stageId":22349}]'