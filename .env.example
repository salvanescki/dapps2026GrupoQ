# ============================================================================
# SonarQube Cloud (Región EU) - Configuración para MCP Server y Agentes
# ============================================================================
# 1. Copia este archivo a `.env` o `.env.local` (ambos están en .gitignore).
# 2. Genera un User Token en SonarQube Cloud:
#    https://sonarcloud.io/account/security
# 3. Pega tu token en SONARQUBE_TOKEN (nunca lo subas al repositorio).

SONARQUBE_TOKEN=
SONARQUBE_ORG=salvanescki
SONARQUBE_PROJECT_KEY=salvanescki_dapps2026GrupoQ

# Región EU es el valor por defecto en SonarQube Cloud (https://sonarcloud.io).
# No cambiar a menos que se migre de región.
SONARQUBE_URL=https://sonarcloud.io

